# Docker Compose 部署的环境变量：复制为仓库根目录的 .env（已在 .gitignore 中），权限 600。
#   cp deploy/compose.env.example .env && chmod 600 .env
# 下面带"请修改"的都必须改；随机串可以用 openssl rand -base64 48 生成。

# ---- 端口与目录（宿主机）----
# 后端只绑定 127.0.0.1:BACKEND_PORT，由宿主机 nginx 反代；改了这里要同步改 deploy/nginx/cn01-docker.conf 的 upstream
BACKEND_PORT=18080
UPLOAD_HOST_DIR=/var/www/cn01/uploads

# ---- 数据库（mysql 容器首次启动时按这里创建库和账号；之后再改密码不会生效）----
DB_NAME=cn01
DB_USER=cn01
DB_PASSWORD=请修改为强密码
DB_ROOT_PASSWORD=请修改为强密码

# ---- Redis ----
REDIS_PASSWORD=请修改为强密码

# ---- 安全 ----
# 至少 32 字节随机串
JWT_SECRET=请用openssl生成
# 首次启动创建管理员 admin 的密码；留空则随机生成并打印在后端日志里（只打印一次）
ADMIN_INIT_PASSWORD=

# ---- 站点 ----
SITE_URL=https://www.yilinga.com

# ---- 在线购买与会员服务：说明见 deploy/backend.env.example ----
SHOP_ENABLED=false
SERVICE_PHONE=136 9928 5133

# ---- 支付 ----
PAY_MODE=mock
PAY_NOTIFY_URL=https://www.yilinga.com/api/pay/notify/wechat
PAY_REFUND_NOTIFY_URL=https://www.yilinga.com/api/pay/notify/wechat-refund
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_SERIAL_NO=
# 容器内路径；宿主机上把 apiclient_key.pem 放到 deploy/wxpay/（或 WXPAY_HOST_DIR 指定的目录）
WXPAY_PRIVATE_KEY_PATH=/etc/cn01/wxpay/apiclient_key.pem
WXPAY_API_V3_KEY=

# ---- 短信 ----
SMS_MOCK=true

# ---- 邮件通知（不配置则只记日志）----
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
NOTIFY_ADMIN_EMAIL=
