# 复制到服务器 /etc/cn01/backend.env，权限 600，属主 root（systemd 读取）
# 所有密码、密钥都不要提交到 git。

# ---- 数据库（MySQL 8，只监听 127.0.0.1）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cn01
DB_USER=cn01
DB_PASSWORD=请修改为强密码

# ---- Redis（只监听 127.0.0.1，并设置密码）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=请修改为强密码

# ---- 安全 ----
# 至少 32 字节随机串：openssl rand -base64 48
JWT_SECRET=请用openssl生成
# 首次启动创建管理员 admin 的密码；留空则随机生成并打印在日志里（只打印一次）
ADMIN_INIT_PASSWORD=

# ---- 站点 ----
SITE_URL=https://www.cn01.com.cn
UPLOAD_DIR=/var/www/cn01/uploads

# ---- 支付：mock 模拟 / wechat 微信支付 Native ----
PAY_MODE=mock
PAY_NOTIFY_URL=https://www.cn01.com.cn/api/pay/notify/wechat
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_SERIAL_NO=
# 商户 API 私钥 apiclient_key.pem 的路径（权限 600，属主 cn01）
WXPAY_PRIVATE_KEY_PATH=/etc/cn01/wxpay/apiclient_key.pem
WXPAY_API_V3_KEY=

# ---- 短信：true 时验证码只写日志并在接口返回（仅限开发演示）。上线前必须为 false 并接入短信服务 ----
SMS_MOCK=true

# ---- 邮件通知（不配置则只记日志）----
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
NOTIFY_ADMIN_EMAIL=
